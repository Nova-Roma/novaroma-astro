---
/**
 * ChallengeCard — Shared card component for rendering challenge items.
 * Used on both the homepage (compact) and challenges index (full).
 *
 * @prop challenge — The challenge content collection entry
 * @prop variant — "compact" (homepage grid) or "full" (challenges listing)
 */
import { getCollection } from "astro:content";

const SDG_COLORS: Record<number, { bg: string; label: string }> = {
  1: { bg: "#E5243B", label: "No Poverty" },
  2: { bg: "#DDA63A", label: "Zero Hunger" },
  3: { bg: "#4C9F38", label: "Good Health" },
  4: { bg: "#C5192D", label: "Quality Education" },
  5: { bg: "#FF3A21", label: "Gender Equality" },
  6: { bg: "#26BDE2", label: "Clean Water" },
  7: { bg: "#FCC30B", label: "Clean Energy" },
  8: { bg: "#A21942", label: "Decent Work" },
  9: { bg: "#FD6925", label: "Innovation" },
  10: { bg: "#DD1367", label: "Reduced Inequalities" },
  11: { bg: "#FD9D24", label: "Sustainable Cities" },
  12: { bg: "#BF8B2E", label: "Responsible Consumption" },
  13: { bg: "#3F7E44", label: "Climate Action" },
  14: { bg: "#0A97D9", label: "Life Below Water" },
  15: { bg: "#56C02B", label: "Life on Land" },
  16: { bg: "#00689D", label: "Peace & Justice" },
  17: { bg: "#19486A", label: "Partnerships" },
};

interface Props {
  challenge: any;
  variant?: "compact" | "full";
}

const { challenge, variant = "full" } = Astro.props;

const isCompact = variant === "compact";
const event = challenge.data.event || "";
const domain = challenge.data.domain_theme || "";
const sdgs = challenge.data.sdgs || [];
const tags = challenge.data.tags || [];
---

<a
  href={`/challenges/${challenge.slug}/`}
  data-event={event}
  data-domain={domain}
  data-sdgs={sdgs.join(",")}
  data-tags={tags.join(",")}
  class:list={[
    "block border border-dashed border-black/15 bg-base-100 hover:bg-accent-50 transition-colors filter-item",
    isCompact ? "p-5" : "p-6 sm:p-8",
  ]}
>
  {/* TOP: Event + Domain badges */}
  <div class:list={["flex flex-wrap items-center mb-3", isCompact ? "gap-1.5" : "gap-2"]}>
    {event && (
      <span class:list={[
        "uppercase font-medium bg-base-900 text-white",
        isCompact ? "text-[10px] px-1.5 py-0.5" : "text-[10px] px-2 py-0.5",
      ]}>
        {event}
      </span>
    )}
    {domain && (
      <span class:list={[
        "uppercase font-medium bg-accent-500 text-white",
        isCompact ? "text-[10px] px-1.5 py-0.5" : "text-[10px] px-2 py-0.5",
      ]}>
        {domain}
      </span>
    )}
  </div>

  {/* MIDDLE: Title, description, coalition */}
  <span class:list={[
    "block font-medium text-accent-600 leading-snug",
    isCompact ? "text-sm" : "text-lg",
  ]}>
    {challenge.data.title}
  </span>
  <span class:list={[
    "block mt-1 text-base-600 line-clamp-2",
    isCompact ? "text-xs mt-2" : "text-sm mt-1",
  ]}>
    {challenge.data.description}
  </span>
  {!isCompact && challenge.data.partner_orgs.length > 0 && (
    <span class="block mt-3 text-xs text-base-500">
      Coalition: {challenge.data.partner_orgs.join(" · ")}
    </span>
  )}

  {/* BOTTOM: SDG badges */}
  <div class:list={["flex flex-wrap", isCompact ? "gap-1 mt-3" : "gap-1.5 mt-4"]}>
    {sdgs.map((sdg: number) => (
      <span
        class:list={[
          "font-medium text-white",
          isCompact ? "text-[9px] px-1 py-0.5" : "text-[10px] px-1.5 py-0.5",
        ]}
        style={`background-color: ${SDG_COLORS[sdg]?.bg || '#666'}`}
      >
        SDG {sdg}: {SDG_COLORS[sdg]?.label || ''}
      </span>
    ))}
  </div>
</a>
